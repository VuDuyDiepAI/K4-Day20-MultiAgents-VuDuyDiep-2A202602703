# Copy this file to .env and fill in the values. NEVER commit .env.
# Option 1 - Azure OpenAI or an OpenAI-compatible gateway (give all three):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# Option 2 - local Ollama (leave Option 1 empty; no API key required):
# ollama pull qwen3:8b
# ollama create qwen3-lab-fast:8b -f Modelfile.lab
# .\Start-LabModel.ps1   # local adapter sets think=false; Ollama stays on 11434
LAB_MODEL=ollama:qwen3-lab-fast:8b
OLLAMA_HOST=http://127.0.0.1:11435
# In Docker: override OLLAMA_HOST=http://host.docker.internal:11435

# Alternative - Gemini (replace LAB_MODEL above):
# LAB_MODEL=google_genai:gemini-3.5-flash
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=false  # use the Gemini Developer API

# Alternative - DeepSeek (replace LAB_MODEL above):
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=

# Qwen3 non-thinking sampling; use 1 for Gemini 3 instead.
LAB_TEMPERATURE=0.7
